    "instagram_ads": {
      "best_for": "Visual products, younger audience",
      "avg_cpc": "$0.50-1.50",
      "conversion_rate": "1-2%",
      "recommended_budget": "$15-75/day"
    },
    "tiktok_ads": {
      "best_for": "Viral content, Gen Z audience",
      "avg_cpc": "$0.50-1",
      "conversion_rate": "2-4%",
      "recommended_budget": "$20-100/day"
